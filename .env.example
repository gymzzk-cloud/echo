# Baza de date (PostgreSQL, găzduită în UE în producție)
DATABASE_URL=postgres://agentready:agentready@localhost:5432/agentready

# Cheie de criptare pentru datele sensibile (32 de octeți în hex). Generează cu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Adresa publică a aplicației (pentru linkuri în emailuri)
APP_URL=http://localhost:3000

# Chei AI: fără ele, motorul rulează în mod DEMO (răspunsuri simulate).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Gemini: cheie din aistudio.google.com (planul gratuit merge). Gol = cel mai nou model Flash al cheii, găsit automat.
GEMINI_API_KEY=
GEMINI_MODEL=
# Cu facturare activă (implicit) socotim costul real. Doar pe planul gratuit: GEMINI_FREE_TIER=1 (cost 0, plafon GEMINI_DAILY_LIMIT pe zi).
GEMINI_FREE_TIER=0
GEMINI_RPM=8
GEMINI_DAILY_LIMIT=200
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Grok (xAI, console.x.ai): cel mai ieftin model disponibil, ales singur. GROK_MODEL fixează unul.
XAI_API_KEY=
GROK_MODEL=
# Meta AI (Meta Model API, developer.meta.com; în 2026 doar din SUA). Fără căutare web.
META_API_KEY=
META_MODEL=muse-spark-1.3
# Google AI Overviews, Google AI Mode și Copilot nu au API oficial: le citim prin SerpApi (serpapi.com)
SERPAPI_API_KEY=
# Motoarele pornite, separate prin virgulă: aioverview, aimode, copilot. Fiecare întrebare costă 1 credit (2 când rezumatul vine separat).
SERP_ENGINES=aioverview,aimode,copilot
# Creditele planului pe lună (gratuit: 100). Ne oprim înainte de ele.
SERPAPI_MONTHLY_LIMIT=100
# O rulare Google se refolosește atâtea zile, fără credit nou.
SERP_REUSE_DAYS=7

# Email (opțional): fără cheie, rapoartele se văd doar în panou
RESEND_API_KEY=
EMAIL_FROM="Echo <raport@exemplu.ro>"

# Afiliere (opțional): parametru adăugat la linkurile "Cumpără"
AFFILIATE_PARAM=

# Abonamente (Stripe). Fără cheie, planurile se văd, dar plata e dezactivată.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENTIE=

# Scorul de încredere devine public pe profilurile revendicate doar cu 1 (după validarea juridică)
TRUST_SCORE_PUBLIC=0

# Adresele care pot deschide paginile interne (ex. /admin/magazine), separate prin virgulă
ADMIN_EMAILS=

# Preluare ușoară (ADR 0002): cât de des recitim catalogul (ore, + decalaj 0–2h per magazin) și pauza între pagini (ms)
CATALOG_SYNC_HOURS=12
CATALOG_PAGE_PAUSE_MS=400

# Costuri AI (vezi CLAUDE.md)
AI_RUN_EVERY_DAYS=7
AI_MONTHLY_BUDGET_USD=5
AI_MAX_OUTPUT_TOKENS=2000

# Cât de des recitim de pe site condițiile magazinului (retur, plată, livrare, întrebări frecvente), în zile
POLICY_REFRESH_DAYS=30

# Conectorul MCP în directoarele Claude / ChatGPT
LEGAL_NAME=            # firma operatorului (politica de confidențialitate)
LEGAL_ID=              # CUI / nr. Registrul Comerțului
LEGAL_ADDRESS=
SUPPORT_EMAIL=         # contact public pentru suport și confidențialitate
OPENAI_APPS_CHALLENGE= # tokenul de verificare a domeniului din OpenAI Platform
MCP_LOG_DAYS=90        # cât păstrăm jurnalul apelurilor MCP
MCP_PLATFORM_RPM=600   # limita pe minut pentru IP-urile platformelor AI
MCP_PLATFORM_CIDRS=160.79.104.0/21
